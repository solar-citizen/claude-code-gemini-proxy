# Copy this to .env and fill in your real key.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults shown
DEFAULT_GEMINI_MODEL="gemma-4-31b-it"
PORT=8787

# Optional — set to 1 to log full request/response bodies (verbose, disk-heavy)
GEMINI_PROXY_DEBUG=0
