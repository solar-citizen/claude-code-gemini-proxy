# Copy this to .env and fill in your real key.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults shown
DEFAULT_GEMINI_MODEL="gemini-3.5-flash-lite"
PORT=8787

# Optional — log verbosity: 1 (no logs), 2 (short logs), 3 (long logs with full bodies)
LOG_LEVEL=1
