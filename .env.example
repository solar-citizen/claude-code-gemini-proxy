# Copy this to .env and fill in your real key.

# Required. Get one at https://aistudio.google.com/apikey
# You can provide multiple keys separated by commas for rotation
GEMINI_API_KEYS="key1,key2,key3"

# Configure ordered fallback models per tier
# Include the [1m] suffix so Claude Code sees the 1M context window
HAIKU_MODELS="gemini-3.5-flash-lite[1m],gemini-3.1-flash-lite[1m]"
SONNET_MODELS="gemini-3.5-flash[1m],gemini-3-flash[1m]"
OPUS_MODELS="gemini-3.6-flash[1m]"

# Rotation mode: "default" (uses only 1st key, with model failover) or "rotation" (rotates across all keys + models)
ROTATION_MODE="default"

# Optional: Cooldown for rate-limited key/model combinations (default: 60)
ROTATION_COOLDOWN_SECONDS=60
PORT=8787

# Optional — log verbosity: 1 (no logs), 2 (short logs), 3 (long logs with full bodies)
LOG_LEVEL=1
